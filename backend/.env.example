# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-50
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-backend.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# --- Supabase PostgreSQL ------------------------------------------------------
# App runtime: TRANSACTION POOLER url (port 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations / backups: the SESSION POOLER url (port 5432, same host as above). Supabase's plain "Direct connection" is IPv6-only,
# which many networks and CI runners lack. Use it only with DJANGO_USE_DIRECT_DB=1 when running migrate/create_owner.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Scheduled jobs -------------------------------------------------------------
# Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET" when this env var is set
CRON_SECRET=change-me-long-random-string
CRON_BATCH_SIZE=500

# --- Login protection -------------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_THROTTLE_RATE=20/min
NUM_PROXIES=1

# --- Images (stored as Base64 in the database) ---------------------------------------
# Vercel rejects request bodies over ~4.5 MB; keep the Base64 cap below that.
IMAGE_MAX_B64_BYTES=4000000
IMAGE_MAX_PIXELS=25000000
IMAGE_MAX_DIMENSION=1600
IMAGE_MAX_PER_ENTITY=10

# --- Manual backups (optional): lets the owner trigger the GitHub backup workflow from the app --------
GITHUB_BACKUP_TOKEN=github_pat_placeholder_actions_write_only
GITHUB_REPO=your-org/isp-platform
GITHUB_BACKUP_WORKFLOW=backup.yml
GITHUB_BACKUP_REF=main
