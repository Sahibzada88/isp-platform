# Quick local start (no Postgres needed): copy this file to ".env" (same folder as manage.py).
#   Windows (PowerShell):  Copy-Item .env.local.example .env
#   Windows (cmd):         copy .env.local.example .env
#   macOS / Linux:         cp .env.local.example .env
# The app reads .env automatically (python-dotenv). Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-dev-only-change-me-0123456789-abcdefghijklmnopqrstuvwxyz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
CRON_SECRET=local-cron-secret
# No DATABASE_URL here => a local SQLite file (db.sqlite3) is used. To use Postgres instead, add:
# DATABASE_URL=postgresql://user:password@localhost:5432/isp
